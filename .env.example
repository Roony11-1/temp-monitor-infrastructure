# ============================================
# Base de Datos
# ============================================
POSTGRES_DB=tempdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# ============================================
# JWT
# ============================================
APP_JWT_SECRET=ezkyO/2l7ExQ5LfJYgGT1dVtF1WGAFMAY6vtvomGmxY=
# Access token: vida corta (se envía en cada petición)
APP_JWT_ACCESS_EXPIRATION_MINUTES=15
# Refresh token: vida larga, se rota y revoca en BD
APP_JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================
# Compactación de lecturas (rollup + purga)
# ============================================
COMPACTACION_ENABLED=false
COMPACTACION_CRON=0 0 3 * * SUN
COMPACTACION_RETENCION_DIAS=30
COMPACTACION_RETENCION_MESES=12
COMPACTACION_MAX_LOTE=100000

# ============================================
# Muestreo de cámaras (scheduler)
# cadencia-ms = intervalo entre muestras (ej. 330000 = 5:30 min)
# initial-delay-ms = retardo inicial tras arrancar
# ============================================
CAMARA_MUESTREO_CADENCIA_MS=330000
CAMARA_MUESTREO_INITIAL_DELAY_MS=60000

# ============================================
# Puertos
# ============================================
SERVER_PORT=8080
FRONTEND_PORT=80

# ============================================
# Frontend - URL base para peticiones API
# Vacío para usar rutas relativas (proxy Nginx)
# ============================================
VITE_API_URL=
